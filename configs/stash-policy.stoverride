  china-company-ip:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaCompanyIp.list
    path: ./rules/china-company-ip.list
    interval: 86400

  download:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Download.list
    path: ./rules/download.list
    interval: 86400

  private-domain:
    behavior: domain
    format: text
    url: https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/private.txt
    path: ./rules/private-domain.txt
    interval: 86400

  applications:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/applications.txt
    path: ./rules/applications.txt
    interval: 86400

  china-cidr:
    behavior: ipcidr
    format: text
    url: https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/cncidr.txt
    path: ./rules/china-cidr.txt
    interval: 86400

# 规则顺序与 clash.ini 的有效 ruleset 行严格一致，按从上到下顺序匹配。
# IP 规则集合使用 no-resolve，最终兜底采用 Stash/Clash YAML 推荐的 MATCH。
rules: #!replace
  - RULE-SET,custom-direct,全球直连
  - RULE-SET,custom-ai,AI
  - RULE-SET,custom-us,美国节点
  - RULE-SET,custom-japan,日本节点
  - RULE-SET,custom-not-japan,非日节点
  - RULE-SET,custom-proxy,节点选择
  - RULE-SET,ai,AI
  - RULE-SET,google,谷歌服务
  - RULE-SET,google-fcm,谷歌服务
  - RULE-SET,telegram,电报消息
  - RULE-SET,telegram-cidr,电报消息,no-resolve
  - RULE-SET,game,游戏平台
  - RULE-SET,github,节点选择
  - RULE-SET,onedrive,微软云盘
  - RULE-SET,microsoft,微软服务
  - RULE-SET,apple,苹果服务
  - RULE-SET,youtube,油管视频
  - RULE-SET,netflix,奈飞视频
  - RULE-SET,bahamut,巴哈姆特
  - RULE-SET,global-media,国外媒体
  - RULE-SET,awavenue-ad,广告拦截
  - RULE-SET,ad,广告拦截
  - RULE-SET,program-ad,应用净化
  - RULE-SET,lan,全球直连
  - RULE-SET,netease-music,网易音乐
  - RULE-SET,bilibili,哔哩哔哩
  - RULE-SET,china-media,国内媒体
  - RULE-SET,china-domain,全球直连
  - RULE-SET,china-company-ip,全球直连
  - RULE-SET,download,全球直连
  - RULE-SET,private-domain,全球直连
  - RULE-SET,applications,全球直连
  - RULE-SET,china-cidr,全球直连,no-resolve
  - RULE-SET,proxy-domain,节点选择
  - RULE-SET,proxy-gfw,节点选择
  - GEOIP,CN,全球直连,no-resolve
  - MATCH,漏网之鱼
